<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面组件 · 液态玻璃面板（浅色）。26dp 圆角（与面板档一致），135° 暖白渐变 +
     一圈发丝边；顶左高光由 widget_glass_sheen 叠在上面。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="135"
        android:startColor="#FCFBF8"
        android:endColor="#EFEBE3" />
    <stroke
        android:width="1dp"
        android:color="#1A000000" />
</shape>
