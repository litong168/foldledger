<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标 · 背景层
  暖色水色渐变：朱橙 -> 亮橙 -> 琥珀 -> 金
  暖色系在启动器里辨识度最高，也最贴「记账」的金币联想
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FFF04E0A" />
                <item android:offset="0.40" android:color="#FFFF7A18" />
                <item android:offset="0.72" android:color="#FFFFA51F" />
                <item android:offset="1" android:color="#FFFFCE4A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右上角一层暖光，让纯色底不至于太平 -->
    <path android:pathData="M108,0 L108,44 C86,40 70,24 66,0 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="108"
                android:startY="0"
                android:endX="70"
                android:endY="40"
                android:type="linear">
                <item android:offset="0" android:color="#2EFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
