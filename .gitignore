# 签名材料绝不入版本库：私钥 + 口令一旦泄露，任何人都能伪造你的更新包。
# 请单独备份 drip-ledger-release.jks 与 keystore.properties（丢了就再也发不了升级包）。
/keystore.properties
*.jks
*.keystore
*.p12

# 构建产物与交付二进制（不进版本库，避免仓库膨胀）
dist/*.apk
dist/*.aab
rust/drip-core/target/
.workbuddy/
generated-images/

# 桌面交付二进制（安装包/绿色包/服务端 tar）——体积大且可由源码重建，绝不入版本库
dist/*.exe
dist/*.zip
dist/*.tar
dist/legacy-green/

# 临时脚本产物与运行日志
scripts/*.log
scripts/ui.xml

# 各模块的构建产物（KSP 生成代码、intermediates、日志都不该进版本库）
common/build/
desktop/build/
app/build/

# 发版脚本临时产物
.github-release-id
